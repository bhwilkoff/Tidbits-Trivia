<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Tidbits.App.Views"
             xmlns:vm="using:Tidbits.App.ViewModels"
             xmlns:net="using:Tidbits.Core.Networking"
             x:Class="Tidbits.App.Views.JoinPlayerView"
             x:DataType="vm:LivePlayerViewModel">
    <ScrollViewer>
        <StackPanel Margin="36,32" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
            <!-- Entry -->
            <StackPanel IsVisible="{Binding NotJoined}" Spacing="12">
                <TextBlock Text="Join a game" FontSize="28" FontWeight="Black"/>
                <TextBlock Text="Enter the 4-letter code from the host's screen." FontSize="14" Opacity="0.7"/>
                <TextBox x:Name="CodeBox" Watermark="Code (e.g. 2NRE)" FontSize="18" MaxLength="4" Padding="12"
                         TextChanged="OnCodeChanged"/>
                <TextBox x:Name="TeamBox" Watermark="Your team name" FontSize="16" Padding="12"/>
                <!-- G7: the tables already in the room. Without this a second phone
                     at a table has no way to know its table is here, types the name
                     slightly differently, and the table plays as two teams with a
                     split score. -->
                <StackPanel IsVisible="{Binding HasRoomTeams}" Spacing="6">
                    <TextBlock Text="Already playing — click to join your table" FontSize="12" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding RoomTeams}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="net:RosterTeam">
                                <Button Click="OnPickTeam" Margin="0,0,6,6" Padding="12,7" FontWeight="SemiBold"
                                        Content="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Join" Click="OnJoin" Classes="accent" Padding="26,12" FontWeight="Bold"/>
                    <!-- There was no way back out of this surface at all. -->
                    <Button Content="Cancel" Click="OnLeave" Padding="18,12"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorText}" Foreground="#D64545" FontSize="13" IsVisible="{Binding HasError}"/>
            </StackPanel>

            <!-- Joined: the game -->
            <StackPanel IsVisible="{Binding !NotJoined}" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding RoomName}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{}{0} pts'}"
                               FontWeight="Black" FontSize="18" Foreground="#FF5C35"/>
                </Grid>

                <TextBlock IsVisible="{Binding WaitingForStart}" Text="You're in! Waiting for the host to start…"
                           Opacity="0.7" FontSize="15"/>

                <TextBlock x:Name="CountdownText" Foreground="#FF5C35" FontSize="26" FontWeight="Black"/>

                <StackPanel IsVisible="{Binding IsBoard}" Spacing="6">
                    <TextBlock Text="{Binding BoardHeadline}" FontWeight="Black" FontSize="20" Foreground="#FF5C35"/>
                    <TextBlock Text="{Binding BoardSummary}" FontSize="13" Opacity="0.7"/>
                </StackPanel>
                <TextBlock IsVisible="{Binding HasLetter}" Text="{Binding LetterBanner}"
                           FontWeight="Black" FontSize="13" Foreground="#FF5C35"/>
                <!-- The question's picture: the small fallback at once, the full room-node
                     version once fetched (Decision 060) -->
                <Border IsVisible="{Binding HasPicture}" CornerRadius="12" ClipToBounds="True" Height="220"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Image x:Name="PictureImage" Stretch="Uniform"/>
                </Border>
                <!-- Decision 060: the host's clip, offered here too -->
                <StackPanel IsVisible="{Binding HasMedia}" Spacing="6">
                    <Button x:Name="ClipButton" Click="OnPlayClip" Classes="accent" Padding="14,10" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" AutomationProperties.Name="Play the clip">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ui:FASymbolIcon Symbol="Play" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock x:Name="ClipTitle" Text="{Binding MediaTitle}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MediaSubtitle}" FontSize="12" Opacity="0.85"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ClipStatus" IsVisible="False" FontSize="12" Opacity="0.75"/>
                    <Border x:Name="ClipVideoFrame" IsVisible="False" CornerRadius="10" ClipToBounds="True" Background="Black" Height="220">
                        <views:VideoSurface x:Name="ClipVideo"/>
                    </Border>
                </StackPanel>
                <TextBlock IsVisible="{Binding ShowQuestionOnly}" Text="{Binding Prompt}"
                           FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                <!-- G1: on a buzz round the whole answer UI is ONE button. Big,
                     because the player is racing and looking at the big screen, not
                     at their phone. -->
                <Button IsVisible="{Binding CanBuzz}" Content="BUZZ" Click="OnBuzz"
                        Classes="accent" FontSize="44" FontWeight="Black"
                        Padding="0,34" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <TextBlock IsVisible="{Binding HasBuzzed}" Text="Buzzed — wait for the host"
                           FontSize="20" FontWeight="Bold" Foreground="#3FCF8E"
                           HorizontalAlignment="Center" Margin="0,18"/>
                <StackPanel x:Name="OptionsPanel" Spacing="0" IsVisible="{Binding ShowOptions}"/>
                <!-- G1: a buzz IS an answer, so this fired alongside "Buzzed — wait for
                     the host" and the player got the same news twice. -->
                <TextBlock IsVisible="{Binding AnswerLocked}" Text="Answer locked ✓" Foreground="#1E9E6A" FontWeight="SemiBold"/>

                <!-- Reveal: the correct answer + the host's story behind it -->
                <Border IsVisible="{Binding HasRevealAnswer}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding RevealAnswerLine, StringFormat='Answer: {0}'}"
                                   Foreground="#1E9E6A" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                        <TextBlock IsVisible="{Binding HasStory}" Text="{Binding Story}"
                                   Opacity="0.85" TextWrapping="Wrap"/>
                        <!-- The charter: where the fact came from. -->
                        <HyperlinkButton IsVisible="{Binding HasSource}" Content="{Binding SourceLine}"
                                         NavigateUri="{Binding SourceUrl}" Padding="0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- The wrap (macOS-DESIGN A3.7): the score, then the learning payoff. -->
                <StackPanel IsVisible="{Binding IsEnded}" Spacing="6" Margin="0,10,0,0">
                    <Border Background="#FF5C35" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                        <TextBlock Text="THAT'S A WRAP" Foreground="White" FontWeight="Black" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding FinalScoreLine}" FontSize="22" FontWeight="Black"/>
                    <StackPanel x:Name="RecapPanel" Spacing="8"/>
                </StackPanel>

                <!-- L5 social graph: add the people you played with -->
                <StackPanel IsVisible="{Binding HasCoplayers}" Spacing="8" Margin="0,6,0,0">
                    <TextBlock Text="Add the people you played with" FontWeight="SemiBold"/>
                    <StackPanel x:Name="CoplayersPanel" Spacing="6"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
