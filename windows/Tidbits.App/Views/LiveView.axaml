<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.LiveView">
    <Panel>
        <ScrollViewer x:Name="Setup">
            <StackPanel Margin="36,32" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Tidbits Live" Classes="view-heading"/>
                <TextBlock Text="The pub-trivia rig: build a branded event, run it from the host cockpit, and put a projector window on the big screen. Desktop only — it needs the second screen and the keyboard."
                           Classes="body" Opacity="0.72" TextWrapping="Wrap"/>
                <TextBlock Text="Just want to play a night with friends? That is Trivia Night, on the Play page — host it from any device, or join one with a code."
                           Classes="caption" Opacity="0.6" TextWrapping="Wrap"/>
                <TextBlock Text="Host options" Classes="section-header" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Category:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox x:Name="CategoryPicker" MinWidth="150"/>
                </StackPanel>
                <CheckBox x:Name="SpeedBonusCheck" Content="Speed bonus — fastest correct answers score extra (+3 / +2 / +1)"/>
                <CheckBox x:Name="HostPlaysCheck" Content="I'll play too (answer on this device and be scored)"/>
                <TextBox x:Name="HostNameBox" PlaceholderText="Your team name" MaxWidth="260"
                         HorizontalAlignment="Left" IsEnabled="{Binding #HostPlaysCheck.IsChecked}"/>

                <TextBlock Text="Build a custom event" Classes="section-header" Margin="0,14,0,0"/>
                <TextBox x:Name="EventNameBox" PlaceholderText="Event name (e.g. Friday Pub Quiz)" MaxWidth="360" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SponsorBox" PlaceholderText="Sponsor (optional)" MinWidth="220"/>
                    <TextBox x:Name="BrandHexBox" PlaceholderText="Brand color #hex" MinWidth="130"/>
                </StackPanel>
                <TextBox x:Name="LeadUrlBox" PlaceholderText="Mailing-list URL (lead-capture QR, optional)" MaxWidth="360" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Repeats:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox x:Name="WeekdayBox" MinWidth="140"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="RoundModeBox" MinWidth="160" Margin="0,0,8,6"/>
                    <ComboBox x:Name="RoundCountBox" MinWidth="90" Margin="0,0,8,6"/>
                    <TextBox x:Name="RoundNoteBox" PlaceholderText="Host note (optional)" MinWidth="180" Margin="0,0,8,6"/>
                    <Button Content="+ Add round" Click="OnAddRound" Margin="0,0,8,6"/>
                    <Button Content="Audio round…" Click="OnAddAudioRound" Margin="0,0,8,6"/>
                    <Button Content="Video round…" Click="OnAddVideoRound" Margin="0,0,8,6"/>
                    <Button Content="Pick-a-category board…" Click="OnAddBoardRound" Margin="0,0,8,6"
                            ToolTip.Tip="A Jeopardy-style grid the room picks from — categories across, point tiers down"/>
                </WrapPanel>
                <StackPanel x:Name="BuilderRounds" Spacing="4"/>
                <CheckBox x:Name="WagerFinalCheck" Content="Make the last round a final wager (teams stake points)"/>
                <!-- Balance meter: question-type mix + variety verdict -->
                <StackPanel x:Name="BalancePanel" Spacing="4" IsVisible="False"/>
                <!-- §6.3b: a WrapPanel, not a StackPanel. Six buttons in a
                     non-wrapping row clip the moment the window is anything but
                     maximised, and a control the host cannot reach is a broken night. -->
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Host this event" Click="OnHostEvent" Classes="accent" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Preview solo" Click="OnPreviewEvent" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Save event" Click="OnSaveEvent" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Print answer sheet" Click="OnPrintAnswerSheet" Padding="16,10" Margin="0,0,8,8"/>
                    <Button x:Name="PrintPackButton" Content="Print question pack" Click="OnPrintQuestionPack" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Export event…" Click="OnExportEvent" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Import event…" Click="OnImportEvent" Padding="16,10" Margin="0,0,8,8"/>
                    <Button Content="Export questions as CSV…" Click="OnExportQuestionsCsv" Padding="16,10" Margin="0,0,8,8"/>
                </WrapPanel>

                <TextBlock x:Name="SavedEventsHeader" Text="Saved events" Classes="section-header"
                           Margin="0,10,0,0" IsVisible="False"/>
                <StackPanel x:Name="SavedEvents" Spacing="6"/>
                <TextBlock x:Name="StatusText" IsVisible="False" Opacity="0.75" FontSize="13" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="CockpitHost"/>
    </Panel>
</UserControl>
