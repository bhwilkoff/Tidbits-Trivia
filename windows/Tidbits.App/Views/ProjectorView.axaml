<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tidbits.App.ViewModels"
             xmlns:views="using:Tidbits.App.Views"
             x:Class="Tidbits.App.Views.ProjectorView"
             x:DataType="vm:LiveHostViewModel">
    <Panel Background="#0A0A12">
        <!-- Lobby: join info + QR -->
        <Viewbox IsVisible="{Binding IsLobby}" Margin="120" Stretch="Uniform">
            <StackPanel Spacing="18" Width="900" HorizontalAlignment="Center">
                <TextBlock Text="JOIN NOW" Foreground="{Binding BrandBrush}" FontSize="60" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="tidbitstrivia.com/live" Foreground="White" FontSize="34" Opacity="0.8" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Host.Code}" Foreground="White" FontSize="150" FontWeight="Black" HorizontalAlignment="Center"/>
                <Border Background="White" Padding="16" CornerRadius="16" HorizontalAlignment="Center">
                    <Image x:Name="LobbyQr" Width="240" Height="240"/>
                </Border>
                <TextBlock IsVisible="{Binding ShowSponsor}" Text="{Binding SponsorLine}" Foreground="White" Opacity="0.55"
                           FontSize="24" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Viewbox>

        <!-- Big-screen standings hold (climbing leaderboard between rounds) -->
        <Viewbox IsVisible="{Binding ShowBigScreenStandings}" Margin="120,80" Stretch="Uniform">
            <StackPanel Width="1100" Spacing="16">
                <TextBlock Text="{Binding StandingsHeadline}" Foreground="{Binding BrandBrush}" FontSize="64" FontWeight="Black" HorizontalAlignment="Center"/>
                <StackPanel IsVisible="{Binding HasNoStandings}" Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="No scores yet" Foreground="White" Opacity="0.75"
                               FontSize="40" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add teams in the cockpit, or have players scan the code to join."
                               Foreground="White" Opacity="0.55" FontSize="26"
                               TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RankedStandings}" x:CompileBindings="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="90,*,Auto" Margin="0,7">
                                <TextBlock Text="{Binding Rank}" Foreground="{Binding RankColor}" FontSize="46" FontWeight="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="46" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Score}" Foreground="White" FontSize="46" FontWeight="Black" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding ShowSponsor}" Text="{Binding SponsorLine}" Foreground="White" Opacity="0.55"
                           FontSize="24" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Viewbox>

        <!-- G5: the pick-a-category grid. A phase of a LIVE round, so it sits
             between the standings hold and the question screen. A taken cell keeps
             its place and goes quiet rather than disappearing: the room reads the
             board as a map of what is left, and a grid that reflows on every pick
             makes them re-find their column. -->
        <Viewbox IsVisible="{Binding ShowBoardScreen}" Margin="100,70" Stretch="Uniform">
            <StackPanel Width="1500" Spacing="20">
                <TextBlock Text="{Binding BoardHeadline}" Foreground="#FF5C35" FontSize="54"
                           FontWeight="Black" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding BoardCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="30" FontWeight="Black"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="BoardGrid" ItemsSource="{Binding BoardTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding BoardColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveHostViewModel+BoardTile">
                            <Border Margin="7" Height="96" CornerRadius="14"
                                    Background="#1AFFFFFF" BorderBrush="#47FFFFFF" BorderThickness="2">
                                <TextBlock Text="{Binding Label}" Foreground="#FF5C35" FontSize="46"
                                           FontWeight="Black" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding BoardSummary}" Foreground="White" Opacity="0.7" FontSize="26"
                           FontWeight="Black" HorizontalAlignment="Center"/>
            </StackPanel>
        </Viewbox>

        <!-- Question / reveal (macOS-DESIGN A8.9 / WINDOWS-DESIGN 6.3c): one 1280x720
             design canvas scaled to the window; every element IN the flow — a hidden
             one takes no space — and the middle column fits its height. No overlay,
             no clearance constant. -->
        <Viewbox IsVisible="{Binding ShowQuestionScreen}" Stretch="Uniform">
            <Grid Width="1280" Height="720" RowDefinitions="Auto,*,Auto,Auto">
                <!-- header: event name | round line -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="36,24,36,10" IsVisible="{Binding ShowHeader}">
                    <TextBlock IsVisible="{Binding ShowTitle}" Text="{Binding EventTitleUpper}" Foreground="{Binding BrandBrush}"
                               FontSize="26" FontWeight="Black" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Column="1" IsVisible="{Binding ShowRoundLine}" Text="{Binding RoundLine}" Foreground="White"
                               Opacity="0.7" FontSize="22" FontWeight="Bold" VerticalAlignment="Bottom" Margin="24,0,0,0"/>
                </Grid>
                <!-- middle: laid out at natural height, then FITTED to what is left -->
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="36,0"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Width="1208" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowChromeRow}">
                            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowChrome}" VerticalAlignment="Center">
                                <TextBlock Text="★ FINAL WAGER ★" IsVisible="{Binding IsWagerRound}" Foreground="#FFC93C"
                                           FontSize="24" FontWeight="Black" VerticalAlignment="Center"/>
                                <Border IsVisible="{Binding ShowRoundIntro}" Background="{Binding BrandBrush}" CornerRadius="8"
                                        Padding="12,3" VerticalAlignment="Center">
                                    <TextBlock Text="NEW ROUND" Foreground="#0A0A12" FontSize="18" FontWeight="Black"/>
                                </Border>
                                <TextBlock Text="{Binding QuestionChrome}" Foreground="White" Opacity="0.55" FontSize="22"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CountdownBig" Grid.Column="1" IsVisible="{Binding ShowCountdown}" Foreground="#FF5C35"
                                       FontSize="56" FontWeight="Black" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Host.Current.Prompt}" Foreground="White" FontSize="{Binding PromptSize}"
                                   FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center"/>
                        <!-- 3.36: the question's picture (a Kahoot import, a package) -->
                        <Border IsVisible="{Binding ShowPicture}" Height="{Binding PictureHeight}" CornerRadius="16" ClipToBounds="True"
                                Background="#1C1C28" HorizontalAlignment="Center" MinWidth="400">
                            <Panel>
                                <TextBlock x:Name="PictureHint" Text="Loading picture" Foreground="White" Opacity="0.6" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="Picture" Stretch="Uniform"/>
                            </Panel>
                        </Border>
                        <!-- G1: name the buzzing team on the big screen. -->
                        <TextBlock IsVisible="{Binding HasBuzz}" Text="{Binding BuzzBanner}" Foreground="#FF5C35" FontSize="40"
                                   FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center"/>
                        <!-- Options (+ live vote bars when the tally is on); the correct one
                             lights up green on reveal. Built in code-behind. -->
                        <StackPanel x:Name="QOptions"/>
                        <TextBlock IsVisible="{Binding ShowRevealAnswer}" Foreground="#3FCF8E" FontSize="44" FontWeight="Black"
                                   TextWrapping="Wrap" TextAlignment="Center" Text="{Binding RevealAnswer}"/>
                        <TextBlock IsVisible="{Binding ShowStatusLine}" Text="{Binding StatusLine}" Foreground="White" Opacity="0.6"
                                   FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                        <!-- The story behind the answer on reveal (3.42) — the room learns why. -->
                        <TextBlock IsVisible="{Binding ShowStory}" Foreground="White" Opacity="0.72" FontSize="24"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="1000" Text="{Binding RevealStory}"/>
                        <!-- The charter on the big screen: where the fact came from (same switch as the story). -->
                        <TextBlock IsVisible="{Binding ShowSource}" Foreground="{Binding BrandBrush}" FontSize="18" FontWeight="Black"
                                   TextAlignment="Center" Text="{Binding RevealSource}"/>
                    </StackPanel>
                </Viewbox>
                <!-- bottom band: team STRIP (wrapping chips) | join card — in the flow -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="36,12,36,0" IsVisible="{Binding ShowBottomRow}">
                    <WrapPanel x:Name="TeamChips" IsVisible="{Binding ShowTeams}" VerticalAlignment="Bottom" Margin="0,0,20,0"/>
                    <Border Grid.Column="1" IsVisible="{Binding ShowJoinPanel}" Background="#1C1C28" CornerRadius="16"
                            BorderBrush="#47FFFFFF" BorderThickness="2" Padding="14,10" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Background="White" CornerRadius="10" Padding="6">
                                <Image x:Name="JoinQr" Width="84" Height="84"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SCAN TO JOIN" Foreground="White" Opacity="0.6" FontSize="14" FontWeight="Black"/>
                                <TextBlock Text="{Binding Host.Code, StringFormat='CODE {0}'}" Foreground="{Binding BrandBrush}"
                                           FontSize="26" FontWeight="Black" FontFamily="Consolas,monospace"/>
                                <TextBlock Text="or tidbitstrivia.com/live" Foreground="White" Opacity="0.6" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- sponsor line, in the flow at the very bottom -->
                <TextBlock Grid.Row="3" IsVisible="{Binding ShowSponsor}" Text="{Binding SponsorLine}" Foreground="White" Opacity="0.55"
                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,20"/>
            </Grid>
        </Viewbox>

        <!-- Ended: final standings -->
        <Viewbox IsVisible="{Binding IsEnded}" Margin="120" Stretch="Uniform">
            <StackPanel Width="900" Spacing="14">
                <TextBlock Text="{Binding WinnerLine}" IsVisible="{Binding HasWinner}" Foreground="#3FCF8E"
                           FontSize="52" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Final standings" Foreground="{Binding BrandBrush}" FontSize="56" FontWeight="Black" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding ModeratedStandings}" x:CompileBindings="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="40"/>
                                <TextBlock Grid.Column="1" Text="{Binding Score}" Foreground="White" FontSize="40" FontWeight="Black" Margin="24,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Lead-capture QR (Wave D) -->
                <StackPanel IsVisible="{Binding HasLeadCapture}" Spacing="10" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock Text="Join the mailing list" Foreground="White" Opacity="0.8" FontSize="26"
                               HorizontalAlignment="Center"/>
                    <Border Background="White" Padding="14" CornerRadius="14" HorizontalAlignment="Center">
                        <Image x:Name="LeadQr" Width="200" Height="200"/>
                    </Border>
                </StackPanel>
                <TextBlock IsVisible="{Binding ShowSponsor}" Text="{Binding SponsorLine}" Foreground="White" Opacity="0.55"
                           FontSize="24" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Viewbox>

        <!-- Wave B video question (§6.3). The clip's picture is routed into a
             VideoFrameSink and drawn here, above every other layer: while a clip plays it
             IS the big screen. Windows had the sink and the surface but nothing wired them
             together, so video played audio-only with no picture anywhere. -->
        <views:VideoSurface x:Name="Video" IsVisible="False"/>
    </Panel>
</UserControl>
