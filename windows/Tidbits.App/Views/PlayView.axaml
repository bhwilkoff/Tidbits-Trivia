<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.PlayView">
    <Panel>
        <ScrollViewer x:Name="Landing">
            <StackPanel Margin="36,30" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Play" Classes="view-heading"/>
                <TextBlock Text="Trivia from the whole of Wikipedia." Classes="body" Opacity="0.7"/>

                <!-- Quick Play hero -->
                <Button Click="OnQuickPlay" Classes="accent" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="24,18" Margin="0,6,0,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="QUICK PLAY" FontSize="23" FontWeight="Black"/>
                        <TextBlock Text="Jump straight into a round" FontSize="13" Opacity="0.9"/>
                    </StackPanel>
                </Button>

                <!-- Surprise me + Customize (Mac/web parity) -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Surprise me" Click="OnSurprise" Classes="compact"/>
                    <Button Content="Customize" Click="OnCustomize" Classes="compact"/>
                </StackPanel>

                <!-- Your mixes (saved presets) -->
                <StackPanel x:Name="PresetsPanel" Spacing="6"/>

                <!-- Category -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Category:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox x:Name="CategoryPicker" MinWidth="150"/>
                </StackPanel>
                <!-- Coverage disclosure: a mode this category cannot fill still plays,
                     assembled from other categories, and silence about that reads as a
                     lie (the rule iOS + web already carry). Collapsed when it doesn't
                     apply, which after the 2026-08-01 content pass is nearly always. -->
                <TextBlock x:Name="CoverageNote" Classes="caption" TextWrapping="Wrap"
                           IsVisible="False" Margin="0,-4,0,0"/>

                <!-- Daily Tidbit (play-once) + Previous Tidbits archive -->
                <TextBlock Text="Daily Tidbit" Classes="section-header" Margin="0,12,0,0"/>
                <StackPanel x:Name="DailyPanel" Spacing="8"/>

                <TextBlock Text="Trivia Night" Classes="section-header" Margin="0,12,0,0"/>
                <TextBlock Text="A themed night of rounds — each round a different question type."
                           FontSize="13" Opacity="0.7"/>
                <WrapPanel x:Name="NightPanel"/>

                <Button Content="Pass &amp; Play — 2–4 players, one device" Click="OnPassAndPlay"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,13" Margin="0,12,0,0"
                        FontWeight="SemiBold"/>

                <!-- Online — Quick Match against a real player (2.21) -->
                <TextBlock Text="Online" Classes="section-header" Margin="0,12,0,0"/>
                <TextBlock Text="Face a real opponent on the same questions — best score wins."
                           Classes="body" Opacity="0.7"/>
                <Button Content="Quick Match — find an opponent online" Click="OnQuickMatch"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="18,13"
                        FontWeight="SemiBold"/>

                <TextBlock Text="Versus CPU" Classes="section-header" Margin="0,12,0,0"/>
                <TextBlock Text="A believable bot opponent, always labeled CPU. Classic rules."
                           FontSize="13" Opacity="0.7"/>
                <WrapPanel x:Name="VersusPanel"/>

                <TextBlock Text="Modes" Classes="section-header" Margin="0,12,0,0"/>
                <WrapPanel x:Name="ModesPanel"/>

                <!-- R-CLUB-1 (docs/iOS-DESIGN.md 5.2a — the rule is cross-platform): the
                     app's ONE Club entry point, quiet and BELOW the free surfaces. Club
                     used to be four cards here plus three in Records; the count of visible
                     locks, not the real free/paid ratio, reads as the size of the paywall. -->
                <ContentControl x:Name="ClubDoorPanel" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="GameHost"/>
    </Panel>
</UserControl>
