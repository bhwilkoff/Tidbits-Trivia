<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidbits.App\Tidbits.App.csproj" />
    <ProjectReference Include="..\Tidbits.Core\Tidbits.Core.csproj" />
    <!-- The Store IAP library is on a Windows TFM, so it cannot be REFERENCED from this
         net10.0 project — the same wall that forces GameData to load it reflectively. Copy its
         output in as content instead, so WindowsStoreGatewayContractTests can exercise the real
         assembly rather than a description of it. -->
    <!-- SkipGetTargetFrameworkProperties: without it MSBuild rejects the reference outright on
         TFM compatibility, even though nothing is being compiled against it. -->
    <ProjectReference Include="..\Tidbits.Windows\Tidbits.Windows.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared corpus (link, not a copy in git) — Windows is another consumer of assets/. -->
    <Content Include="..\..\assets\corpus.json" Link="Fixtures\corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Create golden, captured from the shipped Apple ranker. Linked, not
         copied, so it cannot drift from tools/create/golden/. -->
    <Content Include="..\..\tools\create\golden\search.txt" Link="Fixtures\create-golden.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Full shared data under Data/ so GameData.Shared (app path) resolves in tests too. -->
    <Content Include="..\..\assets\*.json" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>