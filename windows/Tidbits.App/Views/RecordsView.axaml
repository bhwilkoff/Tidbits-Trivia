<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tidbits.App.ViewModels"
             x:Class="Tidbits.App.Views.RecordsView"
             x:DataType="vm:RecordsViewModel">
    <Panel>
    <ScrollViewer>
        <StackPanel Margin="36,32" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Records" Classes="view-heading"/>
            <TextBlock Text="Compete against your past self." FontSize="15" Opacity="0.7"/>

            <!-- Profile / sync banner (2.16): who you're playing as + where records live -->
            <Border Classes="card" Padding="14,12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border x:Name="ProfileAvatar" Width="40" Height="40" CornerRadius="20"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileName" FontWeight="SemiBold"/>
                        <TextBlock Text="Records are saved on this device · edit your profile in Settings"
                                   FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding NoGames}" Margin="0,20,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="No games yet — play a round and your scores, streaks, and knowledge show up here."/>

            <StackPanel IsVisible="{Binding HasGames}" Spacing="18">
                <!-- Streak + lifetime -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Day streak" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding StreakCurrent}" FontSize="30" FontWeight="Black"/>
                            <TextBlock Text="{Binding StreakBest, StringFormat='best {0}'}" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Games" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding LifetimeGames}" FontSize="30" FontWeight="Black"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Accuracy" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{Binding LifetimeAccuracy, StringFormat='{}{0}%'}" FontSize="30" FontWeight="Black"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Recent games -->
                <TextBlock Text="Your games" Classes="section-header"/>
                <ItemsControl ItemsSource="{Binding RecentGames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameRow">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Mode}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12" Opacity="0.65"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ScoreLine}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Date}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button IsVisible="{Binding HasMoreGames}" Click="OnSeeAllGames"
                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                    <TextBlock Foreground="#FF5C35" FontWeight="SemiBold"
                               Text="{Binding TotalGames, StringFormat='See all {0} games ›'}"/>
                </Button>

                <!-- Story Archive (Club — docs/CLUB-FEATURES-BUILD.md "Feature 2"): a
                     "see all" destination off the dashboard (R-REC-1), built in
                     code-behind since it reads live entitlement state, not the VM. -->
                <ContentControl x:Name="StoryArchivePanel" Margin="0,4,0,0"/>

                <!-- Marathon History (Club — docs/CLUB-FEATURES-BUILD.md "Feature 3"):
                     the permanent record of every completed run (R-REC-1), in addition
                     to the Play card's own in-game "See Marathon history" link. -->
                <ContentControl x:Name="MarathonHistoryPanel" Margin="0,4,0,0"/>

                <!-- Knowledge Atlas (Club — docs/CLUB-FEATURES-BUILD.md "Feature 4"): a
                     transparent, INTERPRETED 12-month layer over the same rows the free
                     Topic Levels/Pie below already read (R-MON-1) — every domain row a
                     tap-to-play door, never a passive stats wall. -->
                <ContentControl x:Name="KnowledgeAtlasPanel" Margin="0,4,0,0"/>

                <!-- Knowledge (hidden until a specific-category game is played) -->
                <StackPanel IsVisible="{Binding HasDomains}" Spacing="8">
                    <TextBlock Text="Your knowledge" Classes="section-header" Margin="0,6,0,0"/>
                    <!-- The Pie: breadth across the 7 domains (drawn in code-behind) -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                        <Canvas x:Name="PieCanvas" Width="120" Height="120"/>
                        <TextBlock Text="{Binding PieCaption}" VerticalAlignment="Center" Opacity="0.75" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Domains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DomainRow">
                                <Button Click="OnDomainDrill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="140,*,Auto">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LevelLine}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Badges (levelable milestones; tier number as the icon, no emoji) -->
                <StackPanel IsVisible="{Binding HasBadges}" Spacing="8">
                    <TextBlock Text="Badges" Classes="section-header" Margin="0,6,0,0"/>
                    <ItemsControl ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BadgeRow">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#FF5C35"
                                                VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Tier}" Foreground="White" FontWeight="Black"
                                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Stake calibration (per-confidence-tier hit rate) -->
                <StackPanel IsVisible="{Binding HasCalibration}" Spacing="8">
                    <TextBlock Text="Calibration" Classes="section-header" Margin="0,6,0,0"/>
                    <TextBlock Text="How often you were right at each confidence level (Stake mode)."
                               FontSize="12" Opacity="0.6"/>
                    <ItemsControl ItemsSource="{Binding Calibration}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalibrationRow">
                                <Grid ColumnDefinitions="90,*,Auto" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Rate}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Opacity="0.7"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Personal bests — tap a mode to scroll its previous attempts -->
                <StackPanel IsVisible="{Binding HasBests}" Spacing="8">
                    <TextBlock Text="Personal bests" Classes="section-header" Margin="0,6,0,0"/>
                    <ItemsControl ItemsSource="{Binding Bests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BestRow">
                                <Button Click="OnBestDrill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PlaysLine}" FontSize="12" Opacity="0.6"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Best}" FontWeight="Bold" FontSize="18"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Review -->
                <Border IsVisible="{Binding HasReview}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ReviewCount, StringFormat='{}{0} facts to review'}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <!-- Story Archive "Re-ask this" — overlays the dashboard while a 1-question
         drill plays (mirrors LeaderboardView's DuelGameHost), so re-asking doesn't
         need a nested dialog stacked on the archive's own FAContentDialog. -->
    <ContentControl x:Name="ReaskHost"/>
    <!-- Knowledge Atlas domain play — overlays the dashboard while a full round
         plays (mirrors ReaskHost above), so tapping a domain doesn't need a nested
         dialog stacked on the atlas's own FAContentDialog. -->
    <ContentControl x:Name="AtlasHost"/>
    </Panel>
</UserControl>
