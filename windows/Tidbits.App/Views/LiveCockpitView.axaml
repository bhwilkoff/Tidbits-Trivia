<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Tidbits.App.ViewModels"
             x:Class="Tidbits.App.Views.LiveCockpitView"
             x:DataType="vm:LiveHostViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="28,20">
        <!-- Header: join info + roster status + QR -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <!-- §5.8: the HERO is the content. The join code was FontSize 26 Black
                     while the question — the thing the host reads out loud — was the
                     smaller `section-header`. The code is reference information; it
                     belongs in the room's eyeline on the projector, not shouting on
                     the host's. -->
                <TextBlock Text="{Binding Host.Title}" Classes="view-heading"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Host.Code, StringFormat='Join code {0}'}"
                               Classes="body-strong" Foreground="#FF5C35"/>
                    <TextBlock Text="tidbitstrivia.com/live" Classes="caption" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Host.PlayerCount}" FontWeight="Bold"/>
                    <TextBlock Text="players ·" Opacity="0.7"/>
                    <TextBlock Text="{Binding Host.AnsweredCount}" FontWeight="Bold"/>
                    <TextBlock Text="answered" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="White" Padding="6" CornerRadius="8" VerticalAlignment="Top">
                <Image x:Name="QrImage" Width="104" Height="104"/>
            </Border>
        </Grid>

        <!-- Body: question + standings -->
        <Grid Grid.Row="1" ColumnDefinitions="*,260" Margin="0,16">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Host.RoundTitle}" Classes="caption" FontWeight="SemiBold"/>
                    <!-- G5: the host's copy of the pick-a-category grid. The room
                         calls a cell out loud and the host taps it here. While it is
                         up NOBODY has picked yet, so the question below is hidden —
                         a live prompt with a Reveal button beside it invites the host
                         to reveal a question the room was never asked. -->
                    <StackPanel IsVisible="{Binding ShowBoardScreen}" Spacing="8">
                        <TextBlock Text="{Binding BoardHeadline}" Classes="section-header"/>
                        <ItemsControl ItemsSource="{Binding BoardCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="caption" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding BoardTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding BoardColumns}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LiveHostViewModel+BoardTile">
                                    <Button Content="{Binding Label}" Click="OnPickBoardCell"
                                            IsEnabled="{Binding Playable}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Margin="3" Padding="0,10" FontWeight="Bold"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding BoardSummary}" Classes="caption"/>
                    </StackPanel>
                    <!-- Host's private per-round note (cockpit-only, never on the projector) -->
                    <Border IsVisible="{Binding HasRoundNote}" Background="#22FFC93C" CornerRadius="8" Padding="10,7">
                        <TextBlock Text="{Binding CurrentRoundNote, StringFormat='📝 {0}'}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                    <!-- `section-header`, NOT `view-heading`. Promoting this to the page
                         title size was my own regression: measured on the real box, a
                         long question then filled the whole body and pushed every
                         answer option off the bottom, so the host could not see what
                         the room was choosing between. The hierarchy problem was
                         never that the question was too small — it was that the join
                         code was drawn BIGGER than it (FontSize 26 Black). Shrinking
                         the code fixed it; enlarging the question broke the screen. -->
                    <TextBlock Text="{Binding Host.Current.Prompt}" Classes="section-header" TextWrapping="Wrap"
                               IsVisible="{Binding !ShowBoardScreen}"/>
                    <!-- The authored clip for THIS question (audio/video round). Either a
                         working control or an explicit "unavailable" line — never a play
                         button that does nothing (WINDOWS-DESIGN §6.6). -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasClip}">
                        <Button Click="OnPlayQuestionClip" Classes="accent" Padding="14,8"
                                AutomationProperties.Name="Play clip">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="Play" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Play clip" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Stop" Click="OnStopQuestionClip" Padding="12,8"/>
                        <TextBlock Text="{Binding ClipName}" Classes="caption" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border IsVisible="{Binding ClipMissing}" Background="#22FF5C35" CornerRadius="8" Padding="10,7">
                        <TextBlock Text="Clip unavailable — re-attach it in the builder"
                                   Classes="body-strong" Foreground="#FF5C35" TextWrapping="Wrap"/>
                    </Border>
                    <!-- Options with a live answer-distribution bar (built in code-behind
                         so each row can carry a proportional bar + reveal highlight). -->
                    <StackPanel x:Name="OptionsTally" Spacing="6"/>
                    <!-- Free-text review (Name-It rounds, on reveal): typed answers + Accept -->
                    <StackPanel x:Name="ReviewPanel" Spacing="6" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Standings" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Paper team" Click="OnAddPaperTeam" FontSize="11" Padding="8,3"/>
                </Grid>
                <TextBlock Text="No players yet" Classes="caption"
                           IsVisible="{Binding !Host.PlayerCount}"/>
                <ItemsControl ItemsSource="{Binding Host.Standings}" x:CompileBindings="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,3">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Hide" Click="OnToggleHide" Tag="{Binding Id}"
                                        Padding="7,1" MinWidth="0" FontSize="11" Opacity="0.7"/>
                                <Button Grid.Column="2" Content="−" Click="OnScoreDown" Tag="{Binding Id}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Subtract a point from {0}'}"
                                        Padding="7,1" MinWidth="0" FontWeight="Bold" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Score}" Classes="tabular" FontWeight="Bold"
                                           MinWidth="26" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Grid.Column="4" Content="+" Click="OnScoreUp" Tag="{Binding Id}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Add a point to {0}'}"
                                        Padding="7,1" MinWidth="0" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding HasFlags}" Text="{Binding FlagLine}" Foreground="#FF5C35"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Timer row: live countdown + start/extend/clear. WrapPanel per §6.3b — these
             clip the moment the window is anything but maximised. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,4" VerticalAlignment="Center">
            <TextBlock x:Name="CountdownText" FontSize="20" FontWeight="Black" Foreground="#FF5C35"
                       MinWidth="52" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <Button Content="30s" Click="OnTimer30" Padding="12,7" Margin="0,0,8,6"/>
            <Button Content="60s" Click="OnTimer60" Padding="12,7" Margin="0,0,8,6"/>
            <Button Content="+15" Click="OnAdd15" Padding="12,7" Margin="0,0,8,6"/>
            <Button Content="+30" Click="OnAdd30" Padding="12,7" Margin="0,0,8,6"/>
            <Button Content="Clear" Click="OnClearTimer" Padding="12,7" Margin="0,0,8,6"/>
            <Border IsVisible="{Binding IsLocked}" Background="#FF5C35" CornerRadius="6" Padding="10,4"
                    VerticalAlignment="Center" Margin="0,0,8,6">
                <TextBlock Text="LOCKED" Foreground="White" FontWeight="Black" FontSize="12"/>
            </Border>
        </WrapPanel>

        <!-- WINDOWS-DESIGN §5.8: a Fluent CommandBar, not rows of identical buttons.
             This was NINETEEN default buttons across three WrapPanels with one
             accent, which is what the owner meant by a screen that "seems to simply
             be a list of features and things you can do". The five a host presses
             all night are primary commands with labelled icons; everything else is
             in the ⋯ overflow, which is where Windows puts it. -->
        <ui:FACommandBar Grid.Row="3" DefaultLabelPosition="Right"
                         HorizontalAlignment="Left" Margin="0,4,0,0">
            <ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBarButton Label="Back" Click="OnBack" IsEnabled="{Binding CanGoBack}"
                                       ToolTip.Tip="Back to the previous question">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Previous"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <!-- The ONE command a host hits all night is accented. A Fluent
                     CommandBar draws every command alike, which is right for a
                     toolbar and wrong for a live show where "which one is Reveal"
                     has to be answerable at a glance in a dark room. -->
                <ui:FACommandBarButton Label="Reveal" Click="OnReveal" IsVisible="{Binding !ShowBoardScreen}"
                                       Foreground="#FF5C35" FontWeight="SemiBold"
                                       ToolTip.Tip="Show the answer on the big screen (Space)">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="View"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarButton Label="Next" Click="OnNext" IsVisible="{Binding !ShowBoardScreen}"
                                       ToolTip.Tip="Move the room on">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Next"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarButton Label="Lock" Click="OnLock" IsVisible="{Binding !ShowBoardScreen}"
                                       ToolTip.Tip="Pencils down — stop accepting answers (Ctrl+L)">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Clear"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarButton Label="Skip" Click="OnSkip" IsVisible="{Binding !ShowBoardScreen}"
                                       ToolTip.Tip="Skip this question — no score">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Forward"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarSeparator/>
                <!-- G1: the buzz panel. Only once somebody HAS buzzed — a control
                     naming nobody is noise in a cockpit driven live. -->
                <ui:FACommandBarButton Label="Correct" IsVisible="{Binding HasBuzz}" Click="OnBuzzCorrect"
                                       ToolTip.Tip="{Binding BuzzLabel}">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Accept"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarButton Label="Wrong" IsVisible="{Binding HasBuzz}" Click="OnBuzzWrong"
                                       ToolTip.Tip="Rule this team out and reopen the buzzer to the rest">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Cancel"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
                <ui:FACommandBarButton Label="Break tie" IsVisible="{Binding HasTie}" Click="OnBreakTie">
                    <ui:FACommandBarButton.IconSource>
                        <ui:FASymbolIconSource Symbol="Shuffle"/>
                    </ui:FACommandBarButton.IconSource>
                </ui:FACommandBarButton>
            </ui:FACommandBar.PrimaryCommands>

            <ui:FACommandBar.SecondaryCommands>
                <ui:FACommandBarButton Label="{Binding RemoteLabel}" Click="OnToggleRemote"
                                       ToolTip.Tip="Pair your phone to reveal and advance while you walk the room"/>
                <ui:FACommandBarToggleButton Label="Standings on big screen"
                                             IsChecked="{Binding HoldStandings, Mode=OneWay}" Click="OnToggleHold"/>
                <ui:FACommandBarButton Label="Show on projector" Click="OnProjector"/>
                <ui:FACommandBarButton Label="Audio output" Click="OnAudio"/>
                <ui:FACommandBarSeparator/>
                <ui:FACommandBarButton Label="{Binding PenaltyLabel}" Click="OnCyclePenalty"
                                       ToolTip.Tip="Deduct points for a wrong answer. Teams that do not answer are never penalised."/>
                <ui:FACommandBarButton Label="Merge teams" Click="OnMergeTeams"/>
                <ui:FACommandBarButton Label="Remove team" Click="OnRemoveTeam"/>
                <ui:FACommandBarSeparator/>
                <ui:FACommandBarButton Label="Export standings as CSV" Click="OnExportCsv"/>
                <ui:FACommandBarButton Label="Print standings" Click="OnPrintStandings"/>
                <ui:FACommandBarButton Label="Print question pack" Click="OnPrintPack"/>
                <ui:FACommandBarSeparator/>
                <ui:FACommandBarButton Label="End the night" Click="OnClose"/>
            </ui:FACommandBar.SecondaryCommands>
        </ui:FACommandBar>
    </Grid>
</UserControl>
