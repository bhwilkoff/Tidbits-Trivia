<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.SettingsView">
    <ScrollViewer>
        <StackPanel Margin="36,32" Spacing="22" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Classes="view-heading"/>

            <StackPanel Spacing="10">
                <TextBlock Text="Profile" FontSize="18" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border x:Name="AvatarCircle" Width="52" Height="52" CornerRadius="26"/>
                    <TextBox x:Name="NameBox" Watermark="Your name" MinWidth="200" MaxLength="24"
                             LostFocus="OnNameCommitted"/>
                    <Button Content="Shuffle avatar" Click="OnShuffleAvatar" Padding="14,8"/>
                </StackPanel>
                <TextBlock Text="Your name and avatar show on the leaderboard and when you join a live night."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="AccountSection" Spacing="8">
                <TextBlock Text="Account" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="AccountStatus" FontSize="14" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SignInButton" Content="Sign in with Google"
                            Click="OnSignIn" Padding="14,8"/>
                    <Button x:Name="SignInAppleButton" Content="Sign in with Apple"
                            Click="OnSignInApple" Padding="14,8"/>
                    <Button x:Name="SignOutButton" Content="Sign out" IsVisible="False"
                            Click="OnSignOut" Padding="14,8"/>
                </StackPanel>
                <TextBlock Text="Signing in keeps your records, streak and standings on one profile across every device you play on — phone, computer and the web."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
                <TextBlock x:Name="AccountError" IsVisible="False" FontSize="13"
                           Foreground="#C4442E" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Tidbits Club" FontSize="18" FontWeight="Bold"/>
                <Button x:Name="ClubButton" Content="Join Tidbits Club" Click="OnOpenClub"
                        HorizontalAlignment="Left" Padding="14,8"/>
                <TextBlock Text="Ranked seasons, a knowledge atlas, a story archive, and expeditions — the whole game stays free."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Gameplay" FontSize="18" FontWeight="Bold"/>
                <ToggleSwitch x:Name="ReviewToggle" Content="Review questions" IsCheckedChanged="OnReviewToggled"/>
                <TextBlock Text="Occasionally re-asks questions you've missed, spaced out, so they stick."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Data" FontSize="18" FontWeight="Bold"/>
                <Button Content="Reset seen questions" Click="OnResetSeen" HorizontalAlignment="Left"/>
                <Button Content="Reset all records" Click="OnResetRecords" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DataStatus" IsVisible="False" FontSize="13" Foreground="#1E9E6A"/>
            </StackPanel>

            <!-- Parity with macOS/iOS Settings (Decision 048). Shown whether or not the
                 player signed in, because Tidbits provisions a real (anonymous) account for
                 everyone and that account holds their records too. -->
            <StackPanel Spacing="8">
                <TextBlock Text="Delete account" FontSize="18" FontWeight="Bold"/>
                <Button x:Name="DeleteAccountButton" Content="Delete account…" Click="OnDeleteAccount"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="Permanently deletes your Tidbits account and all of its data — profile, rating, streak, Daily history, standings and friends."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
                <TextBlock x:Name="DeleteStatus" IsVisible="False" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="About" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" FontSize="14"/>
                <TextBlock Text="Content from Wikipedia, available under CC BY-SA. Tidbits is a learning game — every question is a door to learn more."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
