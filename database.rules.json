{
  "rules": {
    "queue": {
      ".read": "auth != null",
      "$bucket": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "!newData.exists() || newData.hasChildren(['roomId','host'])"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && $roomId.length >= 4 && $roomId.length <= 8",
          ".validate": "newData.hasChildren(['host','createdAt'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name'])"
          }
        },
        "msgs": {
          "$msgId": {
            ".write": "auth != null && newData.child('from').val() == auth.uid",
            ".validate": "newData.hasChildren(['from','ts'])"
          }
        }
      }
    },
    "live": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host','createdAt'])",
          ".read": "auth != null"
        },
        "pub": {
          ".write": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
          ".read": "auth != null"
        },
        "scores": {
          ".write": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
          ".read": "auth != null"
        },
        "teams": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name'])"
          },
          ".read": "auth != null"
        },
        "answers": {
          "$qid": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".read": "auth != null && auth.uid === $uid"
            }
          },
          ".read": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid"
        },
        "media": {
          "$id": {
            ".write": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
            ".validate": "newData.hasChildren(['kind','mime','bytes','b64']) && newData.child('b64').isString() && newData.child('b64').val().length <= 4200000 && newData.child('bytes').isNumber() && newData.child('bytes').val() <= 3000000"
          },
          ".read": "auth != null"
        },
        "control": {
          ".write": "auth != null",
          ".read": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
          "id": {
            ".read": "auth != null"
          }
        },
        "jokers": {
          ".write": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
          ".read": "auth != null && root.child('live').child($code).child('meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['round']) && newData.child('round').isNumber()",
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "players": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $key || (auth.token.email_verified === true && root.child('emailOwners').child($key).val() === auth.token.email))",
        ".validate": "newData.hasChildren(['name','createdAt'])"
      }
    },
    "emailOwners": {
      "$key": {
        ".write": "auth != null && auth.token.email_verified === true && ((newData.exists() && newData.val() === auth.token.email && (!data.exists() || data.val() === auth.token.email)) || (!newData.exists() && data.val() === auth.token.email))"
      }
    },
    "dailyBoard": {
      ".read": true,
      "$day": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name','score','correct','marks','at']) && newData.child('marks').isString() && newData.child('marks').val().length === 7 && newData.child('correct').isNumber() && newData.child('correct').val() >= 0 && newData.child('correct').val() <= 7"
        }
      }
    },
    "dailyLog": {
      "$key": {
        ".read": "auth != null && (auth.uid === $key || (auth.token.email_verified === true && root.child('emailOwners').child($key).val() === auth.token.email))",
        ".write": "auth != null && (auth.uid === $key || (auth.token.email_verified === true && root.child('emailOwners').child($key).val() === auth.token.email))"
      }
    },
    "playersPrivate": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "entitlements": {
      "$key": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('emailOwners').child($key).val() === auth.token.email",
        ".write": false
      }
    },
    "standings": {
      ".read": true,
      "$season": {
        "$venue": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name','score'])"
          }
        }
      }
    },
    "duels": {
      "$id": {
        ".read": "auth != null && (data.child('createdBy').val() === auth.uid || data.child('challenged').val() === auth.uid)",
        ".write": "auth != null && !data.exists()",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "quizzes": {
      "$id": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('by').val() === auth.uid)",
        ".validate": "newData.hasChildren(['v','id','t','by','at','qs'])"
      }
    },
    "duelInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$duelId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['from','at'])"
        }
      }
    }
  }
}
