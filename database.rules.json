{
  "rules": {
    "queue": {
      ".read": "auth != null",
      "$bucket": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name','ts']) && newData.child('ts').isNumber()"
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$roomId.length >= 4 && $roomId.length <= 8",
        "meta": {
          ".validate": "newData.hasChildren(['host','createdAt'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name'])"
          }
        },
        "msgs": {
          "$msgId": {
            ".validate": "newData.hasChildren(['from','ts']) && newData.child('from').val() == auth.uid"
          }
        }
      }
    }
  }
}
