<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections: Firebase RTDB (Tidbits Live host), Wikipedia
	     live-generation, Commons images. No server / no incoming. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read files the host picks via NSOpenPanel: CSV question import (Wave A) and audio
	     clips for playback / audio rounds (Wave B). Read-only — we never write them back. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Same Game Center capability the iOS/tvOS slices use (shared App ID). -->
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
