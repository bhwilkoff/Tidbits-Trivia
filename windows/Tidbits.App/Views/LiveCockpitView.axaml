<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tidbits.App.ViewModels"
             x:Class="Tidbits.App.Views.LiveCockpitView"
             x:DataType="vm:LiveHostViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="28,20">
        <!-- Header: join info + roster status + QR -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Host.Code, StringFormat='Join code: {0}'}" FontSize="26" FontWeight="Black" Foreground="#FF5C35"/>
                <TextBlock Text="tidbitstrivia.com/live" FontSize="13" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Host.PlayerCount}" FontWeight="Bold"/>
                    <TextBlock Text="players ·" Opacity="0.7"/>
                    <TextBlock Text="{Binding Host.AnsweredCount}" FontWeight="Bold"/>
                    <TextBlock Text="answered" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="White" Padding="6" CornerRadius="8" VerticalAlignment="Top">
                <Image x:Name="QrImage" Width="104" Height="104"/>
            </Border>
        </Grid>

        <!-- Body: question + standings -->
        <Grid Grid.Row="1" ColumnDefinitions="*,220" Margin="0,16">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Host.RoundTitle}" Opacity="0.6" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Host.Current.Prompt}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                    <!-- Options with a live answer-distribution bar (built in code-behind
                         so each row can carry a proportional bar + reveal highlight). -->
                    <StackPanel x:Name="OptionsTally" Spacing="6"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Standings" FontWeight="Bold"/>
                <TextBlock Text="No players yet" FontSize="12" Opacity="0.5"
                           IsVisible="{Binding !Host.PlayerCount}"/>
                <ItemsControl ItemsSource="{Binding Host.Standings}" x:CompileBindings="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,3">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Hide" Click="OnToggleHide" Tag="{Binding Id}"
                                        Padding="7,1" MinWidth="0" FontSize="11" Opacity="0.7"/>
                                <Button Grid.Column="2" Content="−" Click="OnScoreDown" Tag="{Binding Id}"
                                        Padding="7,1" MinWidth="0" FontWeight="Bold" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Score}" FontWeight="Bold"
                                           MinWidth="26" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Grid.Column="4" Content="+" Click="OnScoreUp" Tag="{Binding Id}"
                                        Padding="7,1" MinWidth="0" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding HasFlags}" Text="{Binding FlagLine}" Foreground="#FF5C35"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Timer row: live countdown + start/extend/clear -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock x:Name="CountdownText" FontSize="20" FontWeight="Black" Foreground="#FF5C35"
                       MinWidth="52" VerticalAlignment="Center"/>
            <Button Content="30s" Click="OnTimer30" Padding="12,7"/>
            <Button Content="60s" Click="OnTimer60" Padding="12,7"/>
            <Button Content="+15" Click="OnAdd15" Padding="12,7"/>
            <Button Content="+30" Click="OnAdd30" Padding="12,7"/>
            <Button Content="Clear" Click="OnClearTimer" Padding="12,7"/>
        </StackPanel>

        <!-- Controls -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="‹ Back" Click="OnBack" Padding="14,10" IsEnabled="{Binding CanGoBack}"/>
                <Button Content="Reveal" Click="OnReveal" Classes="accent" Padding="20,10" FontWeight="Bold"/>
                <Button Content="Next" Click="OnNext" Padding="20,10"/>
                <Button Content="Skip ›" Click="OnSkip" Padding="14,10"/>
                <Button Content="Lock" Click="OnLock" Padding="20,10"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Export CSV" Click="OnExportCsv" Padding="16,10"/>
                <Button Content="Show on projector" Click="OnProjector" Padding="16,10"/>
                <Button Content="End night" Click="OnClose" Padding="16,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
