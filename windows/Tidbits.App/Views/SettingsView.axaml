<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.SettingsView">
    <ScrollViewer>
        <StackPanel Margin="36,32" Spacing="22" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="34" FontWeight="Black"/>

            <StackPanel Spacing="10">
                <TextBlock Text="Profile" FontSize="18" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border x:Name="AvatarCircle" Width="52" Height="52" CornerRadius="26"/>
                    <TextBox x:Name="NameBox" Watermark="Your name" MinWidth="200" MaxLength="24"
                             LostFocus="OnNameCommitted"/>
                    <Button Content="Shuffle avatar" Click="OnShuffleAvatar" Padding="14,8"/>
                </StackPanel>
                <TextBlock Text="Your name and avatar show on the leaderboard and when you join a live night. Sync across devices arrives later."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Gameplay" FontSize="18" FontWeight="Bold"/>
                <ToggleSwitch x:Name="ReviewToggle" Content="Review questions" IsCheckedChanged="OnReviewToggled"/>
                <TextBlock Text="Occasionally re-asks questions you've missed, spaced out, so they stick."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Data" FontSize="18" FontWeight="Bold"/>
                <Button Content="Reset seen questions" Click="OnResetSeen" HorizontalAlignment="Left"/>
                <Button Content="Reset all records" Click="OnResetRecords" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DataStatus" IsVisible="False" FontSize="13" Foreground="#1E9E6A"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="About" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" FontSize="14"/>
                <TextBlock Text="Content from Wikipedia, available under CC BY-SA. Tidbits is a learning game — every question is a door to learn more."
                           FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
