<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must track Tidbits.App's host-conditional TFM exactly: a net10.0 test project cannot
         reference a net10.0-windows app, so on Windows this flips with it. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <!-- Same NETSDK1083 fix as Tidbits.App — the Windows TFM injects deleted win10-* RIDs. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifiers>
    <TargetPlatformMinVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <!-- The Windows TFM also switches on MSBuild's Appx/PRI packaging targets, whose
         ExpandPriContent task ships with Visual Studio and NOT with the dotnet CLI SDK
         (MSB4062 on windows-latest). We never want them: the MSIX is packed explicitly with
         makeappx in windows-store.yml, from a staged layout. `None` says "MSBuild does not
         package this app", which is exactly true. -->
    <WindowsPackageType Condition="$([MSBuild]::IsOSPlatform('Windows'))">None</WindowsPackageType>
    <EnableMsixTooling Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</EnableMsixTooling>
    <EnableDefaultPriItems Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</EnableDefaultPriItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidbits.App\Tidbits.App.csproj" />
    <ProjectReference Include="..\Tidbits.Core\Tidbits.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared corpus (link, not a copy in git) — Windows is another consumer of assets/. -->
    <Content Include="..\..\assets\corpus.json" Link="Fixtures\corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Create golden, captured from the shipped Apple ranker. Linked, not
         copied, so it cannot drift from tools/create/golden/. -->
    <Content Include="..\..\tools\create\golden\search.txt" Link="Fixtures\create-golden.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Full shared data under Data/ so GameData.Shared (app path) resolves in tests too. -->
    <Content Include="..\..\assets\*.json" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>