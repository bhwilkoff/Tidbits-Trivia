<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.CreateView">
    <Panel>
        <ScrollViewer x:Name="Landing">
            <StackPanel Margin="36,32" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Create" Classes="view-heading"/>
                <TextBlock Text="Generate a quiz on any topic — real, vetted questions from the whole of Wikipedia."
                           FontSize="15" Opacity="0.72" TextWrapping="Wrap"/>
                <TextBox x:Name="TopicBox" Watermark="e.g. The Renaissance" FontSize="16" Padding="14,12" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Play it as" Classes="caption" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeBox" MinWidth="180" SelectedIndex="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="GenBtn" Content="Generate Quiz" Click="OnGenerate"
                            Classes="accent" Padding="24,13" FontWeight="Bold"/>
                    <Button Content="Import CSV" Click="OnImportCsv" Padding="18,13" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressBar x:Name="GenProgress" IsIndeterminate="True" IsVisible="False" Height="4"/>
                <TextBlock x:Name="StatusText" IsVisible="False" Opacity="0.75" TextWrapping="Wrap" FontSize="14"/>
                <Button x:Name="SaveBtn" Content="Save this set" Click="OnSaveSet" IsVisible="False"
                        Padding="18,10" FontWeight="SemiBold" HorizontalAlignment="Left"/>

                <TextBlock Text="Need a spark?" Classes="section-header" Margin="0,14,0,0"/>
                <WrapPanel x:Name="SparkPanel" Orientation="Horizontal"/>

                <TextBlock x:Name="SavedHeader" Text="Saved sets" Classes="section-header"
                           Margin="0,14,0,0" IsVisible="False"/>
                <StackPanel x:Name="SavedPanel" Spacing="8"/>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="GameHost"/>
    </Panel>
</UserControl>
