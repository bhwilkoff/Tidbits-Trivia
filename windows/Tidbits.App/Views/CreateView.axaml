<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.CreateView">
    <Panel>
        <ScrollViewer x:Name="Landing">
            <StackPanel Margin="36,32" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Create" FontSize="34" FontWeight="Black"/>
                <TextBlock Text="Generate a quiz on any topic — real, vetted questions from the whole of Wikipedia."
                           FontSize="15" Opacity="0.72" TextWrapping="Wrap"/>
                <TextBox x:Name="TopicBox" Watermark="e.g. The Renaissance" FontSize="16" Padding="14,12" Margin="0,6,0,0"/>
                <Button x:Name="GenBtn" Content="Generate Quiz" Click="OnGenerate"
                        Classes="accent" Padding="24,13" FontWeight="Bold" HorizontalAlignment="Left"/>
                <TextBlock x:Name="StatusText" IsVisible="False" Opacity="0.75" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="GameHost"/>
    </Panel>
</UserControl>
