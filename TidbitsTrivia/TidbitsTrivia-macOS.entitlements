<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections: Firebase RTDB (Tidbits Live host), Wikipedia
	     live-generation, Commons images. No server / no incoming. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Files the host picks via NSOpenPanel/NSSavePanel: CSV question import + audio/video
	     clips (read), and CSV results export (write). Read-write covers both. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Same Game Center capability the iOS/tvOS slices use (shared App ID). -->
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
