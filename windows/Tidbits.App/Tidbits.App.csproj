<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ONE TFM, chosen by the HOST, not multi-targeting.
         Windows builds get `net10.0-windows…` so `Windows.Services.Store` (WinRT, and the
         only way to read a Microsoft Store licence or run a purchase) is reachable and the
         `WINDOWS` symbol is defined. The Mac head stays plain `net10.0`, which is what keeps
         Decision 045's whole observability story working — headless Skia renders and the 511
         tests run here, off Windows.
         Deliberately NOT `<TargetFrameworks>`: no publish in .github/workflows passes a
         framework flag, and multi-targeting makes that an error. Single TFM per host keeps
         those commands untouched, and nothing in the workflows or tools hardcodes a
         framework path (they all pass an explicit output dir). -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <!-- A `net10.0-windows10.0.x` TFM makes the SDK default RuntimeIdentifiers to the UWP-era
         `win10-x64;win10-x86;win10-arm;win10-arm64` list, which .NET 5+ deleted — every one of
         them then fails NETSDK1083 ("RuntimeIdentifier 'win10-x64' is not recognized") before a
         line of our code compiles. Naming the modern RID explicitly overrides that list. -->
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifiers>
    <!-- Do not let the TFM silently raise the OS floor above what AppxManifest advertises
         (Windows.Desktop MinVersion 10.0.17763.0). 19041 is the SDK we compile against;
         17763 stays the minimum we run on. -->
    <TargetPlatformMinVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <!-- The Windows TFM also switches on MSBuild's Appx/PRI packaging targets, whose
         ExpandPriContent task ships with Visual Studio and NOT with the dotnet CLI SDK
         (MSB4062 on windows-latest). We never want them: the MSIX is packed explicitly with
         makeappx in windows-store.yml, from a staged layout. `None` says "MSBuild does not
         package this app", which is exactly true. -->
    <WindowsPackageType Condition="$([MSBuild]::IsOSPlatform('Windows'))">None</WindowsPackageType>
    <EnableMsixTooling Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</EnableMsixTooling>
    <EnableDefaultPriItems Condition="$([MSBuild]::IsOSPlatform('Windows'))">false</EnableDefaultPriItems>
    <Nullable>enable</Nullable>
    <!-- Marketing version, kept in lockstep with AppVersion.xcconfig by
         tools/stamp_msix_version.py. Surfaces in Settings > About via
         Assembly.GetName().Version.ToString(3). -->
    <Version>1.6.73</Version>
    <!-- VideoFrameSink copies LibVLC frames into a WriteableBitmap (3.34). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The shared question data (link, not copied into git) — Windows consumes assets/ like web/Android. -->
    <Content Include="..\..\assets\*.json" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- Wave B AV (owner-chosen LibVLCSharp — cross-platform, verifiable on the Mac). -->
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <!-- LibVLC natives are RID-specific and MUST be conditioned. Referencing both
         unconditionally put the 42MB macOS dylib into the win-x64 Store package.
         With no RID (the Mac dev head / headless tests) both come along, which is
         what lets AvPlayer be exercised locally. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21"
                      Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                      Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidbits.Core\Tidbits.Core.csproj" />
  </ItemGroup>

  <!-- Trim what a win-x64 ship must never carry:
       - libvlc/win-x86 (~99MB): VideoLAN.LibVLC.Windows ships BOTH arches; an x64
         app cannot load the 32-bit tree, so it is dead weight.
       - native .pdb symbols (~105MB, mostly libSkiaSharp.pdb): debug symbols for
         users to download and never use.
       Together these were over half the package. -->
  <Target Name="TrimWindowsPublishBloat" AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_TidbitsBloat Include="$(PublishDir)libvlc\win-x86\**\*" />
      <_TidbitsBloat Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_TidbitsBloat)" />
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86" />
    <Message Importance="high" Text="Trimmed win-x86 LibVLC + native pdbs from $(PublishDir)" />
  </Target>

</Project>
