<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.App"
             xmlns:local="using:Tidbits.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark; FluentAvaloniaTheme gives the WinUI 11 look. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Brand tokens (shared design system — WINDOWS-DESIGN §5.1). -->
        <Color x:Key="BrandPrimary">#FF5C35</Color>
        <Color x:Key="BrandAccent">#0047FF</Color>
    </Application.Resources>

    <Application.Styles>
        <!-- Brand-coral accent (WINDOWS-DESIGN §5.1) instead of the default purple. -->
        <sty:FluentAvaloniaTheme CustomAccentColor="#FF5C35" />

        <!-- Reusable design-token styles (WINDOWS-DESIGN §7.1) — one definition, many
             views: chunky card, chunky/compact buttons. Adopt via Classes="card" etc. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Button.chunky">
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- §5.3 The six-level type ramp (L1 page title -> L6 tabular), one
             definition adopted via Classes. Density comes from removing chrome,
             not adding decoration (mobile-first-density-design); refuse a 7th level. -->
        <Style Selector="TextBlock.view-heading">     <!-- L1 page title -->
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.section-header">   <!-- L2 section header -->
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.body-strong">      <!-- L3 emphasized body -->
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.body">             <!-- L4 body -->
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.caption">          <!-- L5 caption -->
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="TextBlock.tabular">          <!-- L6 tabular (scores/times) -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace"/>
        </Style>
    </Application.Styles>
</Application>
