<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tidbits.App.Views.LiveView">
    <Panel>
        <ScrollViewer x:Name="Setup">
            <StackPanel Margin="36,32" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="Tidbits Live" FontSize="34" FontWeight="Black"/>
                <TextBlock Text="Host a trivia night — players join from their phones by a 4-letter code. The host cockpit runs the show; a projector window goes on the big screen."
                           FontSize="15" Opacity="0.72" TextWrapping="Wrap"/>
                <TextBlock Text="Night options" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Category:" VerticalAlignment="Center" Opacity="0.7"/>
                    <ComboBox x:Name="CategoryPicker" MinWidth="150"/>
                </StackPanel>
                <CheckBox x:Name="SpeedBonusCheck" Content="Speed bonus — fastest correct answers score extra (+3 / +2 / +1)"/>
                <CheckBox x:Name="HostPlaysCheck" Content="I'll play too (answer on this device and be scored)"/>
                <TextBox x:Name="HostNameBox" Watermark="Your team name" MaxWidth="260"
                         HorizontalAlignment="Left" IsEnabled="{Binding #HostPlaysCheck.IsChecked}"/>

                <TextBlock Text="Host a night" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                <StackPanel x:Name="PresetsPanel" Spacing="10"/>

                <!-- Build a custom event -->
                <TextBlock Text="Or build a custom event" FontSize="18" FontWeight="Bold" Margin="0,14,0,0"/>
                <TextBox x:Name="EventNameBox" Watermark="Event name (e.g. Friday Pub Quiz)" MaxWidth="360" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SponsorBox" Watermark="Sponsor (optional)" MinWidth="220"/>
                    <TextBox x:Name="BrandHexBox" Watermark="Brand color #hex" MinWidth="130"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="RoundModeBox" MinWidth="160"/>
                    <ComboBox x:Name="RoundCountBox" MinWidth="90"/>
                    <Button Content="+ Add round" Click="OnAddRound"/>
                </StackPanel>
                <StackPanel x:Name="BuilderRounds" Spacing="4"/>
                <!-- Balance meter: question-type mix + variety verdict -->
                <StackPanel x:Name="BalancePanel" Spacing="4" IsVisible="False"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Host this event" Click="OnHostEvent" Classes="accent" Padding="16,10"/>
                    <Button Content="Preview solo" Click="OnPreviewEvent" Padding="16,10"/>
                    <Button Content="Save event" Click="OnSaveEvent" Padding="16,10"/>
                </StackPanel>

                <TextBlock x:Name="SavedEventsHeader" Text="Saved events" FontSize="16" FontWeight="Bold"
                           Margin="0,10,0,0" IsVisible="False"/>
                <StackPanel x:Name="SavedEvents" Spacing="6"/>
                <TextBlock x:Name="StatusText" IsVisible="False" Opacity="0.75" FontSize="13" TextWrapping="Wrap"/>

                <TextBlock Text="Or join a game" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"/>
                <Button Content="Join a game with a code" Click="OnJoinGame" Padding="18,12" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="CockpitHost"/>
    </Panel>
</UserControl>
